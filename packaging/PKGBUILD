# Build from the working-tree archive generated by make package.
# Copy dist/cast-0.4.0-source.tar.gz beside this file, then run makepkg.
pkgname=cast
pkgver=0.4.0
pkgrel=1
pkgdesc='Minimal screen and webcam presentation camera with independent local recording'
arch=('x86_64' 'aarch64')
license=('MIT' 'BSD-3-Clause' 'GPL-3.0-or-later' 'OFL-1.1' 'Zlib') # Arch FFmpeg is GPL-enabled; see docs/dependencies.md.
depends=('ffmpeg' 'pipewire' 'glib2' 'libx11' 'libxext' 'libxrandr' 'libxi' 'libxfixes' 'libxcomposite' 'sdl3' 'sdl3_ttf' 'curl' 'fontconfig' 'freetype2' 'noto-fonts')
makedepends=('pkgconf')
checkdepends=('python' 'dbus')
optdepends=('v4l2loopback-dkms: virtual camera kernel device'
            'linux-headers: DKMS build for the linux kernel; match your actual kernel'
            'xdg-desktop-portal: Wayland screen capture consent'
            'sxhkd: example Xorg control bindings')
source=("cast-$pkgver-source.tar.gz")
sha256sums=('SKIP') # Local source archive: verify its provenance; set a checksum for distribution.

build() {
  cd "cast-$pkgver"
  make X11=1 WAYLAND=1 PANEL=1 PREFIX=/usr
}

check() {
  cd "cast-$pkgver"
  make X11=1 WAYLAND=1 PANEL=1 check
}

package() {
  cd "cast-$pkgver"
  make X11=1 WAYLAND=1 PANEL=1 PREFIX=/usr DESTDIR="$pkgdir" install
}
