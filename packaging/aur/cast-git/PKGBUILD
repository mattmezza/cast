# Maintainer: Matteo Merola <mattmezza@gmail.com>
pkgname=cast-git
pkgver=0.1.r8.3427382
pkgrel=1
pkgdesc='Screen and webcam presentation camera with recording, RTMP streaming and a control panel'
arch=('x86_64' 'aarch64')
url='https://github.com/mattmezza/cast'
# Source is MIT/BSD; the Inter font is OFL and SDL is Zlib. Arch FFmpeg is GPL-enabled.
license=('MIT' 'BSD-3-Clause' 'OFL-1.1' 'Zlib' 'GPL-3.0-only')
depends=('glibc' 'ffmpeg' 'pipewire' 'glib2' 'libx11' 'libxext' 'libxrandr'
         'libxi' 'libxfixes' 'libxcomposite' 'sdl3' 'sdl3_ttf' 'curl' 'fontconfig' 'freetype2' 'noto-fonts')
makedepends=('git' 'pkgconf')
checkdepends=('python' 'dbus' 'openssl')
optdepends=('v4l2loopback-dkms: virtual camera kernel device'
            'linux-headers: DKMS headers for the linux kernel; use headers matching your kernel'
            'xdg-desktop-portal: Wayland screen capture consent'
            'xdg-desktop-portal-impl: desktop-specific portal implementation'
            'sxhkd: example Xorg control bindings')
provides=("cast=$pkgver")
conflicts=('cast')
source=('cast::git+https://github.com/mattmezza/cast.git#branch=main')
sha256sums=('SKIP') # A moving Git branch is identified by the resulting package version/commit.

pkgver() {
  cd "$srcdir/cast"
  git describe --long --tags --match 'v[0-9]*' \
    | sed 's/^v//;s/\([^-]*-\)g/r\1/;s/-/./g'
}

build() {
  cd "$srcdir/cast"
  make X11=1 WAYLAND=1 PANEL=1 PREFIX=/usr CFLAGS="$CFLAGS"
}

check() {
  cd "$srcdir/cast"
  make X11=1 WAYLAND=1 PANEL=1 CFLAGS="$CFLAGS" check
}

package() {
  cd "$srcdir/cast"
  make X11=1 WAYLAND=1 PANEL=1 PREFIX=/usr DESTDIR="$pkgdir" CFLAGS="$CFLAGS" install
}
