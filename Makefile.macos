# Local macOS recorder build. Linux keeps its existing build and release pipeline.
.DEFAULT_GOAL := all
CC = clang
BREW_PREFIX := $(shell command -v brew >/dev/null 2>&1 && brew --prefix)
MACOS_UPDATE_PKGCONFIG = $(BREW_PREFIX)/opt/curl/lib/pkgconfig:$(BREW_PREFIX)/opt/libarchive/lib/pkgconfig
PKG_CONFIG ?= pkg-config
MACOS_MEDIA_PKGCONFIG =
MACOS_PKG_CONFIG = env PKG_CONFIG_PATH="$(MACOS_MEDIA_PKGCONFIG)$(MACOS_UPDATE_PKGCONFIG):$(PKG_CONFIG_PATH)" $(PKG_CONFIG)
EDITION ?= community
PANEL ?= 1
CUI ?= 0
MACOS_MIN ?= 13.0
CFLAGS ?= -O2 -g
WARN = -Wall -Wextra -Wformat=2 -Wstrict-prototypes -Wmissing-prototypes
VERSION = 0.10.4
CXX = clang++
PREFIX ?= /usr/local
MEDIA_PROFILE ?= system
PRO_ROOT ?= $(abspath ../cast-pro)
PRO_DIR = $(if $(wildcard $(PRO_ROOT)/pro/src/pro_provider.c),$(PRO_ROOT)/pro,$(PRO_ROOT))
PRODUCTION_LICENSE_ACCEPTANCE ?= 0
PRO_TRUST_HEADER ?= $(PRO_DIR)/src/trusted_keys.h
LGPL_ROOT ?= $(CURDIR)/build/deps-lgpl
OFFICIAL_RELEASE ?= 0
RELEASE_TIMESTAMP ?= 0
STT ?= 0
STT_ENGINEERING ?= 0
STT_GPU_ENGINEERING ?= 0
STT_PROFILE ?= $(CURDIR)/build/deps-stt-needle/profile.json
STT_CFLAGS ?= $(if $(filter pro:1,$(EDITION):$(STT)),$(shell $(MACOS_PKG_CONFIG) --cflags '$(dir $(STT_PROFILE))prefix/lib/pkgconfig/needle.pc'))
STT_LIBS ?= $(if $(filter pro:1,$(EDITION):$(STT)),$(shell $(MACOS_PKG_CONFIG) --libs '$(dir $(STT_PROFILE))prefix/lib/pkgconfig/needle.pc'))
STT_CPU_BACKEND ?=
STT_HELPER_PATH ?= $(PREFIX)/libexec/cast-pro-stt-helper
BINARY = cast
APP_NAME = Super Screencast
PRIVATE_REVISION = not-linked
ifeq ($(filter $(EDITION),community pro),)
$(error EDITION must be community or pro)
endif
ifeq ($(filter $(MEDIA_PROFILE),system lgpl),)
$(error MEDIA_PROFILE must be system or lgpl)
endif
ifneq ($(filter-out 0 1,$(STT) $(STT_ENGINEERING) $(STT_GPU_ENGINEERING)),)
$(error STT STT_ENGINEERING STT_GPU_ENGINEERING must be 0 or 1)
endif
ifeq ($(OFFICIAL_RELEASE),1)
$(error macOS builds are local development builds; distribution auditing/signing is not implemented)
endif
ifeq ($(STT),1)
ifneq ($(EDITION),pro)
$(error STT=1 requires EDITION=pro)
endif
endif
ifeq ($(STT_GPU_ENGINEERING),1)
$(error macOS Vulkan engineering builds are not supported)
endif
ifneq ($(filter-out 0 1,$(PRODUCTION_LICENSE_ACCEPTANCE)),)
$(error PRODUCTION_LICENSE_ACCEPTANCE must be 0 or 1)
endif
ifeq ($(PRODUCTION_LICENSE_ACCEPTANCE),1)
ifneq ($(EDITION),pro)
$(error production license acceptance requires Pro)
endif
CPPFLAGS += -DCAST_PRODUCTION_LICENSE_ACCEPTANCE=1
endif
ifeq ($(EDITION),pro)
BINARY = cast-pro
APP_NAME = Super Screencast Pro
ifneq ($(MEDIA_PROFILE),lgpl)
$(error Pro requires MEDIA_PROFILE=lgpl; system GPL media is forbidden)
endif
ifeq ($(wildcard $(PRO_DIR)/src/pro_provider.c),)
$(error Missing private Pro provider under $(PRO_ROOT))
endif
PRO_SOURCES = $(PRO_DIR)/src/pro_provider.c $(PRO_DIR)/src/license_verifier.c $(PRO_DIR)/src/bounded_json.c $(wildcard $(PRO_DIR)/src/cinematic_motion/*.c $(PRO_DIR)/src/speech/*.c $(PRO_DIR)/src/notes/*.c)
PRIVATE_REVISION = $(shell git -C '$(PRO_ROOT)' rev-parse HEAD)
CPPFLAGS += -DCAST_EDITION_PRO=1 -DWITH_PRO -I$(PRO_DIR)/src -DCAST_TRUST_HEADER='"$(PRO_TRUST_HEADER)"'
endif
ifeq ($(MEDIA_PROFILE),lgpl)
MACOS_MEDIA_PKGCONFIG = $(LGPL_ROOT)/prefix/lib/pkgconfig:
CPPFLAGS += -DCAST_MEDIA_PROFILE_LGPL=1
LDFLAGS += -Wl,-rpath,$(LGPL_ROOT)/prefix/lib
endif
ifneq ($(filter-out 0 1,$(PANEL)),)
$(error PANEL must be 0 or 1)
endif
PACKAGES = libsodium libcurl libarchive fontconfig freetype2 libavcodec libavformat libavutil libswscale libswresample
ifeq ($(PANEL),1)
PACKAGES += sdl3 sdl3-ttf
endif
ifneq ($(filter-out 0 1,$(CUI)),)
$(error CUI must be 0 or 1)
endif
CUI_SOURCES =
CUI_LIBRARIES =
CUI_FONT_OBJECT =
CUI_HASH_INPUTS =
ifeq ($(CUI):$(PANEL),1:1)
$(error CUI=1 requires PANEL=0; the prototype and legacy panel use incompatible Clay versions)
endif
ifeq ($(CUI),1)
PACKAGES += sdl3 freetype2 harfbuzz
ifeq ($(EDITION),pro)
PACKAGES += sdl3-ttf
endif
CUI_SOURCES = ui/main.c ui/app.c ui/menus.c ui/settings.c ui/cast_theme.c ui/brand.c ui/source_picker.c ui/daemon_bridge.c ui/timeline_controls.c ui/stream_controls.c ui/file_dialog.c ui/file_dialog_model.c ui/workspace_preferences.c
ifeq ($(EDITION),pro)
CUI_SOURCES += $(wildcard $(PRO_DIR)/src/workspace/*.c)
CPPFLAGS += -Iui
endif
CUI_LIBRARIES = ui/build/vendor/libcui_sdl3.a ui/build/vendor/libcui_text.a ui/build/vendor/libcui_bidi.a ui/build/vendor/libcui.a
CUI_FONT_OBJECT = $(BUILD)/ui/workspace_fonts.o
CUI_HASH_INPUTS = $(CUI_SOURCES) $(wildcard ui/*.h ui/*.S ui/.cui-lock.json ui/assets/fonts/*.otf ui/assets/fonts/*.ttf) ui/Makefile ui/sources.mk
CPPFLAGS += -DWITH_CUI -DCAST_CUI_EMBEDDED -Iui/vendor/include -Iui/vendor/third_party/clay
endif
ifeq ($(filter clean deps-lgpl deps-stt,$(MAKECMDGOALS)),)
ifeq ($(shell $(MACOS_PKG_CONFIG) --exists $(PACKAGES) 'libavcodec >= 61.19.100' && echo yes),)
$(error Missing macOS build dependencies or FFmpeg is too old ($(shell $(MACOS_PKG_CONFIG) --print-errors --exists $(PACKAGES) 'libavcodec >= 61.19.100' 2>&1)); run brew install pkgconf ffmpeg fontconfig freetype harfbuzz sdl3 sdl3_ttf libsodium curl libarchive; Pro also needs make deps-lgpl)
endif
endif
PKG_CFLAGS := $(shell $(MACOS_PKG_CONFIG) --cflags $(PACKAGES))
PKG_LIBS := $(shell $(MACOS_PKG_CONFIG) --libs $(PACKAGES))
PKG_VERSIONS := $(shell $(MACOS_PKG_CONFIG) --modversion $(PACKAGES))
INTEGRATION_ID := $(shell { printf '%s' 'darwin:$(EDITION):$(MEDIA_PROFILE):$(PRO_ROOT):$(PRO_TRUST_HEADER):$(STT):$(STT_CFLAGS):$(STT_LIBS):$(STT_CPU_BACKEND):$(STT_HELPER_PATH):$(STT_PROFILE):$(STT_ENGINEERING):$(CPPFLAGS):$(PANEL):$(CUI):$(MACOS_MIN):$(CC):$(CFLAGS):$(LDFLAGS):$(PRIVATE_REVISION):$(RELEASE_TIMESTAMP):$(PKG_CFLAGS):$(PKG_LIBS):$(PKG_VERSIONS)'; cat $(CUI_HASH_INPUTS) src/*.[chm] src/*.S Makefile.macos $(PRO_SOURCES) $(if $(filter pro,$(EDITION)),$(wildcard $(PRO_DIR)/src/*.h $(PRO_DIR)/src/*/*.h $(PRO_DIR)/src/*/*.cpp) $(PRO_TRUST_HEADER)) $(wildcard $(STT_PROFILE)); } | shasum -a 256 | cut -c1-32)
BUILD = build/macos-$(EDITION)-p$(PANEL)-$(INTEGRATION_ID)
CPPFLAGS += -Isrc -Ivendor/inih -D_DARWIN_C_SOURCE -DWITH_MACOS \
 -DCAST_APPLICATION_NAME='"$(BINARY)"' -DCAST_PLATFORM='"macos-$(shell uname -m)"' \
 -DCAST_BUILD_ID='"$(INTEGRATION_ID)"' -DCAST_MEDIA_PROFILE='"$(MEDIA_PROFILE)"' -DCAST_PRIVATE_REVISION='"$(PRIVATE_REVISION)"' \
 -DCAST_CORE_REVISION='"$(shell git rev-parse HEAD)"' -DCAST_RELEASE_TIMESTAMP=$(RELEASE_TIMESTAMP) \
 -DINI_HANDLER_LINENO=1 -DINI_CALL_HANDLER_ON_NEW_SECTION=1 -DINI_ALLOW_MULTILINE=0 \
 -DINI_ALLOW_INLINE_COMMENTS=0 -DINI_STOP_ON_FIRST_ERROR=1 -DINI_MAX_LINE=8192
CFLAGS += -mmacosx-version-min=$(MACOS_MIN)
LDFLAGS += -Wl,-headerpad_max_install_names
LDLIBS = -lm -lpthread -framework Foundation -framework AVFoundation \
 -framework ScreenCaptureKit -framework CoreMedia -framework CoreVideo \
 -framework CoreGraphics -framework AudioToolbox -framework CoreAudio -framework AppKit
SOURCES = src/timeline.c src/project.c src/project_session.c src/timeline_assets.c src/timeline_render.c src/local_image_input.c src/timeline_preview.c src/timeline_audio.c src/timeline_audio_native.c src/live_media.c src/runtime_metrics.c src/encoder_capabilities.c src/audio_monitor.c src/audio_monitor_session.c src/audio_monitor_session_media.c src/audio_monitor_controller.c src/audio_monitor_controller_media.c src/main.c src/commands.c src/config.c src/config_migrate.c src/state.c \
 src/compositor.c src/composition_assets.c src/presentation_text.c src/platform.c \
 src/media.c src/record.c src/stream.c src/panel_transport.c src/panel_lifecycle.c \
 src/help_commands.c src/update.c src/desktop_update.c src/desktop_update_ui.c src/edition.c src/license_store.c src/edition_extensions.c \
 src/workflow_schema.c src/edition_service.c src/media_codec.c src/app_runtime.c \
 src/os_compat.c vendor/inih/ini.c $(PRO_SOURCES)
OBJC_SOURCES = $(if $(filter pro,$(EDITION)),$(PRO_DIR)/src/speech/model_fetch_macos.m) src/platform_macos.m src/audio_macos.m src/audio_monitor_macos.m src/webcam_macos.m src/preview_macos.m
ASSETS = $(BUILD)/src/command_assets.o
ifeq ($(PANEL),1)
SOURCES += src/panel.c src/panel_color_pick.c
OBJC_SOURCES += src/panel_macos.m
CPPFLAGS += -DWITH_PANEL -Ivendor/clay
ASSETS += $(BUILD)/src/panel_font.o
endif
OBJECTS = $(SOURCES:%.c=$(BUILD)/%.o) $(CUI_SOURCES:%.c=$(BUILD)/%.o) $(CUI_FONT_OBJECT) $(OBJC_SOURCES:%.m=$(BUILD)/%.o) $(ASSETS)
ifeq ($(EDITION):$(STT),pro:1)
CPPFLAGS += -DCAST_WITH_STT -DCAST_STT_HELPER_PATH='"$(STT_HELPER_PATH)"'
STT_HELPER = $(BUILD)/cast-pro-stt-helper
STT_IDENTITY_SOURCES = src/os_compat.c src/edition.c src/license_store.c $(PRO_DIR)/src/license_verifier.c $(PRO_DIR)/src/bounded_json.c
STT_IDENTITY_OBJECTS = $(STT_IDENTITY_SOURCES:%.c=$(BUILD)/helper/%.o)
endif
.PHONY: all FORCE macos-app check check-macos check-unit clean
all: $(BINARY) $(STT_HELPER)
FORCE:
$(BINARY): FORCE $(OBJECTS) $(CUI_LIBRARIES) $(STT_HELPER)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJECTS) $(CUI_LIBRARIES) $(PKG_LIBS) $(LDLIBS)
ifeq ($(EDITION),pro)
	@python3 -c 'import json,subprocess; i=json.loads(subprocess.check_output(["./cast-pro","edition","--json"])); assert i["edition"]=="pro" and i["media_profile"]=="lgpl" and i["extension_api"]==2' || { rm -f cast-pro; exit 1; }
endif
$(BUILD)/%.o: %.c src/cast.h
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -std=gnu11 -MMD -MP -c $< -o $@
$(BUILD)/%.o: %.m src/cast.h
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -std=gnu11 -fobjc-arc -fblocks -MMD -MP -c $< -o $@
# Refresh pinned CUI archives through their own dependency-aware build.
.PHONY: cui-libraries
ifeq ($(CUI),1)
cui-libraries:
	$(MAKE) -C ui build/vendor/libcui_sdl3.a build/vendor/libcui_text.a build/vendor/libcui_bidi.a build/vendor/libcui.a
$(CUI_LIBRARIES): | cui-libraries
endif
$(BUILD)/ui/workspace_fonts.o: ui/workspace_fonts.S $(wildcard ui/assets/fonts/*.otf ui/assets/fonts/*.ttf)
	@mkdir -p $(dir $@)
	$(CC) -c $< -o $@
$(BUILD)/src/command_assets.o: src/command_assets.S completions/cast.bash completions/_cast completions/cast.fish packaging/install.sh
	@mkdir -p $(dir $@)
	$(CC) -mmacosx-version-min=$(MACOS_MIN) -c $< -o $@
$(BUILD)/src/panel_font.o: src/panel_font.S assets/fonts/Inter.ttf
	@mkdir -p $(dir $@)
	$(CC) -mmacosx-version-min=$(MACOS_MIN) -c $< -o $@
-include $(OBJECTS:.o=.d)
macos-app: $(BINARY) $(STT_HELPER)
ifeq ($(PANEL),1)
	python3 packaging/macos-app.py --binary ./$(BINARY) --output "build/macos/$(APP_NAME).app" $(if $(STT_HELPER),--stt-helper $(STT_HELPER) --speech-profile $(STT_PROFILE)) $(if $(filter 1,$(MACOS_STANDALONE)),--standalone) $(if $(filter lgpl,$(MEDIA_PROFILE)),--media-root '$(LGPL_ROOT)') $(if $(filter pro,$(EDITION)),--pro-root '$(PRO_ROOT)') $(if $(PRO_EULA),--pro-eula '$(PRO_EULA)')
else
	@echo 'macos-app requires PANEL=1' >&2; exit 1
endif
CORE_SOURCES = src/edition.c src/license_store.c src/edition_extensions.c src/workflow_schema.c \
 src/compositor.c src/composition_assets.c src/presentation_text.c src/config.c src/state.c \
 src/os_compat.c vendor/inih/ini.c $(PRO_SOURCES)
$(BUILD)/test_core: tests/test_core.c $(CORE_SOURCES)
	@mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) $(LDFLAGS) -std=gnu11 -o $@ $^ $(PKG_LIBS) $(LDLIBS)
$(BUILD)/test_visual: tests/test_visual.c tests/compositor_runtime_stubs.c src/compositor.c src/composition_assets.c src/presentation_text.c
	@mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) $(LDFLAGS) -std=gnu11 -o $@ $^ $(PKG_LIBS) $(LDLIBS)
$(BUILD)/test_os_compat: tests/test_os_compat.c src/os_compat.c src/os_compat.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(WARN) -Werror -std=gnu11 -Isrc -o $@ tests/test_os_compat.c src/os_compat.c -pthread
.PHONY: check-os-compat
check-os-compat: $(BUILD)/test_os_compat
	$(BUILD)/test_os_compat
$(BUILD)/test_macos_preview: tests/test_macos_preview.m src/preview_macos.m src/preview_macos.h src/cast.h
	@mkdir -p $(BUILD)
	$(CC) -Isrc $(CFLAGS) $(WARN) -Werror -std=gnu11 -fobjc-arc -fblocks -o $@ tests/test_macos_preview.m src/preview_macos.m -framework AppKit -framework CoreGraphics
$(BUILD)/test_macos_panel: tests/test_macos_panel.m src/panel_macos.m src/panel_macos.h
	@mkdir -p $(BUILD)
	$(CC) -Isrc $(CFLAGS) $(WARN) -Werror -std=gnu11 -fobjc-arc -fblocks -o $@ tests/test_macos_panel.m src/panel_macos.m -framework AppKit
.PHONY: check-macos-panel
check-macos-panel: $(BUILD)/test_macos_panel
	$(BUILD)/test_macos_panel
$(BUILD)/test_macos_pointer: tests/test_macos_pointer.c src/macos_pointer.h src/cast.h
	@mkdir -p $(BUILD)
	$(CC) -Isrc $(CFLAGS) $(WARN) -Werror -std=gnu11 -o $@ tests/test_macos_pointer.c
$(BUILD)/test_macos_audio: tests/test_macos_audio.m src/audio_macos.m src/media_internal.h src/cast.h
	@mkdir -p $(BUILD)
	$(CC) -Isrc $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -DCAST_TEST -fobjc-arc -fblocks -o $@ tests/test_macos_audio.m src/audio_macos.m $(PKG_LIBS) -framework AVFoundation -framework ScreenCaptureKit -framework CoreMedia -framework Foundation
.PHONY: check-macos-audio
check-macos-audio: $(BUILD)/test_macos_audio
	$(BUILD)/test_macos_audio
check-unit: check-os-compat check-macos-panel check-macos-audio $(BUILD)/test_core $(BUILD)/test_visual $(BUILD)/test_macos_preview $(BUILD)/test_macos_pointer
	$(BUILD)/test_core
	$(BUILD)/test_visual
	$(BUILD)/test_macos_preview
	$(BUILD)/test_macos_pointer
check check-macos: $(BINARY) check-unit
	python3 tests/test_macos_smoke.py --binary ./$(BINARY)
clean:
	rm -rf build/macos-p* build/macos-community-p* build/macos-pro-p* build/macos cast cast-pro

.PHONY: edition-preflight deps-lgpl deps-stt check-pro-cli
edition-preflight:
	python3 packaging/audit.py profile --edition $(EDITION) --media-profile $(MEDIA_PROFILE) --lgpl-root '$(LGPL_ROOT)' --pro-root '$(PRO_ROOT)' --trust-header '$(PRO_TRUST_HEADER)' --official 0 --release-timestamp $(RELEASE_TIMESTAMP)
ifeq ($(EDITION):$(STT),pro:1)
	python3 packaging/speech-profile.py verify --profile '$(STT_PROFILE)' --official 0 --engineering $(STT_ENGINEERING) --cpu-backend '$(STT_CPU_BACKEND)' --cflags='$(STT_CFLAGS)' --libs='$(STT_LIBS)'
endif
$(OBJECTS): | edition-preflight
deps-lgpl:
	sh tools/deps-lgpl.sh $(DEPS_ARGS)
deps-stt:
	python3 tools/deps-stt.py $(DEPS_ARGS)
check-speech-profiles:
	python3 tests/test_speech_profile.py
	python3 tests/test_needle_profile.py
.PHONY: check-speech-profiles
check-pro-cli: $(BINARY)
	python3 tests/test_pro_cli.py --binary ./$(BINARY) --pro-root '$(PRO_DIR)'
ifeq ($(EDITION):$(STT),pro:1)
$(STT_HELPER) $(STT_IDENTITY_OBJECTS) $(BUILD)/helper/needle_helper.o: | edition-preflight
$(BUILD)/helper/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -MMD -MP -c $< -o $@
$(BUILD)/helper/needle_helper.o: $(PRO_DIR)/src/speech/needle_helper.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(STT_CFLAGS) -DCAST_SPEECH_HELPER_EXECUTABLE $(CFLAGS) -Wall -Wextra -Werror -std=c++17 -MMD -MP -c $< -o $@
$(STT_HELPER): $(BUILD)/helper/needle_helper.o $(STT_IDENTITY_OBJECTS)
	@mkdir -p $(dir $@)
	$(CXX) $(CFLAGS) $(LDFLAGS) -Wl,-dead_strip -o $@ $^ $(STT_LIBS) $(shell $(MACOS_PKG_CONFIG) --libs libsodium) -lpthread -lm
-include $(STT_IDENTITY_OBJECTS:.o=.d) $(BUILD)/helper/needle_helper.d
endif

.PHONY: install
install: $(BINARY) $(STT_HELPER)
	install -d '$(DESTDIR)$(PREFIX)/bin'
	install -m755 $(BINARY) '$(DESTDIR)$(PREFIX)/bin/$(BINARY)'
ifeq ($(EDITION):$(STT),pro:1)
	install -d '$(DESTDIR)$(PREFIX)/libexec'
	install -m755 '$(STT_HELPER)' '$(DESTDIR)$(PREFIX)/libexec/cast-pro-stt-helper'
endif

# Synthetic controller integration never requests desktop capture permissions.
$(BUILD)/test_commands: tests/test_commands.c $(OBJECTS)
	@mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -std=gnu11 -fobjc-arc -fblocks $(LDFLAGS) -o $@ tests/test_commands.c $(filter-out $(BUILD)/src/main.o $(BUILD)/src/panel.o,$(OBJECTS)) $(PKG_LIBS) $(LDLIBS)
.PHONY: check-commands
check-commands: $(OBJECTS) $(BUILD)/test_commands
	$(BUILD)/test_commands > $(BUILD)/commands-status.json

$(BUILD)/test_desktop_update: tests/test_desktop_update.c src/desktop_update.c src/desktop_update.h src/desktop_update_keys.h
	@mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 $(LDFLAGS) -o $@ tests/test_desktop_update.c $(PKG_LIBS) $(LDLIBS)
$(BUILD)/test_desktop_update_lifecycle: tests/test_desktop_update_lifecycle.c tests/test_desktop_update.c src/desktop_update.c src/desktop_update_ui.c src/desktop_update.h src/desktop_update_ui.h
	@mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 $(LDFLAGS) -o $@ tests/test_desktop_update_lifecycle.c $(PKG_LIBS) $(LDLIBS)
.PHONY: check-desktop-update-lifecycle
check-desktop-update-lifecycle: $(BUILD)/test_desktop_update_lifecycle
	$(BUILD)/test_desktop_update_lifecycle
.PHONY: check-desktop-update
check-desktop-update: $(BUILD)/test_desktop_update $(BUILD)/test_desktop_update_lifecycle
	$(BUILD)/test_desktop_update
	$(BUILD)/test_desktop_update_lifecycle

.PHONY: check-desktop-update-guard
check-desktop-update-guard: $(BUILD)/test_commands
	CAST_TEST_DESKTOP_UPDATE_GUARD_ONLY=1 $(BUILD)/test_commands

# Isolated document/renderer tests never open capture or audio devices.
PROJECT_TEST_SOURCES = src/project.c src/timeline.c src/config.c src/edition_extensions.c src/workflow_schema.c src/edition.c src/license_store.c src/presentation_text.c src/os_compat.c vendor/inih/ini.c
PROJECT_RENDER_TEST_SOURCES = src/local_image_input.c src/timeline_preview.c src/timeline_render.c src/media_codec.c src/compositor.c src/state.c
PROJECT_TEST_FLAGS = $(filter -DCAST_MEDIA_PROFILE_LGPL=%,$(CPPFLAGS)) -D_GNU_SOURCE -DCAST_TEST -Isrc -Ivendor/inih -DINI_HANDLER_LINENO=1 -DINI_CALL_HANDLER_ON_NEW_SECTION=1 -DINI_ALLOW_MULTILINE=0 -DINI_ALLOW_INLINE_COMMENTS=0 -DINI_STOP_ON_FIRST_ERROR=1 -DINI_MAX_LINE=8192
$(BUILD)/test_timeline: tests/test_timeline.c src/timeline.c src/timeline.h
	@mkdir -p $(BUILD)
	$(CC) $(PROJECT_TEST_FLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -o $@ tests/test_timeline.c src/timeline.c -lm
$(BUILD)/test_project: tests/test_project.c $(PROJECT_TEST_SOURCES)
	@mkdir -p $(BUILD)
	$(CC) $(PROJECT_TEST_FLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -ffunction-sections -fdata-sections -o $@ $^ $(LDFLAGS) -Wl,-dead_strip $(PKG_LIBS) -lpthread -lm
$(BUILD)/test_project_session: tests/test_project_session.c src/project_session.c src/timeline_assets.c src/timeline_audio.c src/audio_monitor.c $(PROJECT_TEST_SOURCES) $(PROJECT_RENDER_TEST_SOURCES)
	@mkdir -p $(BUILD)
	$(CC) $(PROJECT_TEST_FLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -ffunction-sections -fdata-sections -o $@ $^ $(LDFLAGS) -Wl,-dead_strip $(PKG_LIBS) -lpthread -lm
$(BUILD)/test_timeline_render: tests/test_timeline_render.c $(PROJECT_TEST_SOURCES) $(PROJECT_RENDER_TEST_SOURCES)
	@mkdir -p $(BUILD)
	$(CC) $(PROJECT_TEST_FLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -ffunction-sections -fdata-sections -o $@ $^ $(LDFLAGS) -Wl,-dead_strip $(PKG_LIBS) -lpthread -lm
.PHONY: check-timeline check-project check-project-session check-timeline-render
check-timeline: $(BUILD)/test_timeline
	$(BUILD)/test_timeline
check-project: $(BUILD)/test_project
	$(BUILD)/test_project
check-project-session: $(BUILD)/test_project_session
	$(BUILD)/test_project_session
check-timeline-render: $(BUILD)/test_timeline_render
	$(BUILD)/test_timeline_render

# Same synthetic telemetry/encoder policy checks as Linux; no device opening.
$(BUILD)/test_audio_levels: tests/test_audio_levels.c src/audio_macos.m src/audio_levels.h src/media_internal.h src/cast.h
	@mkdir -p $(BUILD)
	$(CC) -Isrc $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -DCAST_TEST -fobjc-arc -fblocks -o $@ tests/test_audio_levels.c src/audio_macos.m $(PKG_LIBS) -framework AVFoundation -framework ScreenCaptureKit -framework CoreMedia -framework Foundation
$(BUILD)/test_encoder_policy: tests/test_encoder_policy.c src/media_codec.c src/media_codec.h src/cast.h
	@mkdir -p $(BUILD)
	$(CC) $(CPPFLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -o $@ tests/test_encoder_policy.c src/media_codec.c $(PKG_LIBS) $(LDLIBS) $(LDFLAGS)
.PHONY: check-audio-levels check-encoder-policy
check-audio-levels: $(BUILD)/test_audio_levels
	$(BUILD)/test_audio_levels
check-encoder-policy: $(BUILD)/test_encoder_policy
	$(BUILD)/test_encoder_policy
check-unit: check-audio-levels check-encoder-policy

$(BUILD)/test_timeline_preview: tests/test_timeline_preview.c $(PROJECT_TEST_SOURCES) $(PROJECT_RENDER_TEST_SOURCES)
	@mkdir -p $(BUILD)
	$(CC) $(PROJECT_TEST_FLAGS) $(PKG_CFLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -ffunction-sections -fdata-sections -o $@ $^ $(LDFLAGS) -Wl,-dead_strip $(PKG_LIBS) -lpthread -lm
.PHONY: check-timeline-preview
check-timeline-preview: $(BUILD)/test_timeline_preview
	$(BUILD)/test_timeline_preview

.PHONY: check-workspace-projects
check-workspace-projects: $(BINARY)
	CAST_TEST_BINARY='$(abspath $(BINARY))' python3 tests/test_workspace_projects.py

# Fake capture/output only: these targets never open a native audio device.
MONITOR_TEST_FLAGS = -Isrc -D_POSIX_C_SOURCE=200809L
$(BUILD)/test_audio_monitor: tests/test_audio_monitor.c src/audio_monitor.c src/audio_monitor.h
	@mkdir -p $(BUILD)
	$(CC) $(MONITOR_TEST_FLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -o $@ tests/test_audio_monitor.c -lpthread -lm
$(BUILD)/test_audio_monitor_session: tests/test_audio_monitor_session.c src/audio_monitor.c src/audio_monitor_session.c src/audio_monitor_session_media.c src/audio_monitor.h src/audio_monitor_session.h src/cast.h
	@mkdir -p $(BUILD)
	$(CC) $(MONITOR_TEST_FLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -o $@ $(filter %.c,$^) -lpthread -lm
$(BUILD)/test_audio_monitor_controller: tests/test_audio_monitor_controller.c src/audio_monitor.c src/audio_monitor_session.c src/audio_monitor_controller.c src/audio_monitor.h src/audio_monitor_session.h src/audio_monitor_controller.h
	@mkdir -p $(BUILD)
	$(CC) $(MONITOR_TEST_FLAGS) $(CFLAGS) $(WARN) -Werror -std=gnu11 -o $@ $(filter %.c,$^) -lpthread -lm
.PHONY: check-audio-monitor check-audio-monitor-session check-audio-monitor-controller check-audio-monitoring
check-audio-monitor: $(BUILD)/test_audio_monitor
	$(BUILD)/test_audio_monitor
check-audio-monitor-session: $(BUILD)/test_audio_monitor_session
	$(BUILD)/test_audio_monitor_session
check-audio-monitor-controller: $(BUILD)/test_audio_monitor_controller
	$(BUILD)/test_audio_monitor_controller
check-audio-monitoring: check-audio-monitor check-audio-monitor-session check-audio-monitor-controller
check-unit: check-audio-monitoring

$(BUILD)/test_timeline_audio: tests/test_timeline_audio.c src/timeline_audio.c src/audio_monitor.c $(PROJECT_TEST_SOURCES) $(PROJECT_RENDER_TEST_SOURCES)
